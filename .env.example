# MyHQ configuration. Copy to .env.local (never committed) and fill in.
# Every variable read by the app starts with MYHQ_ or HQ_, and none of them is
# passed on to the agents (HQ_CLAUDE_OAUTH_TOKEN reaches them under the name
# Claude Code expects, see below).

# Home directory: rooms, role prompts and data. Absolute, or relative to the
# root of this repository. Default: ./home (ignored by Git).
MYHQ_HOME=./home

# Port of the service started by pm2 (ecosystem.config.cjs reads it from this
# file). `npm run dev` and `npm start` stay on 4242. Default: 4242.
HQ_PORT=4242

# Daily cap on the number of runs, all agents together (local calendar day).
# Default: 12. Start low, raise after a week of measurements.
# `maxRunsPerDay` in <home>/myhq.json (or the settings page) wins over this
# variable when it is set; this is the fallback.
HQ_MAX_RUNS_PER_DAY=12

# Routines: set to on to let the cron of room.json start runs on its own.
# Default: off (nothing starts by itself, whatever the agents' "armed" says).
# Each firing goes through the agent lock and the daily cap above, and is
# written to the routine journal. One MyHQ process per home runs them.
# `scheduler` (true or false) in <home>/myhq.json wins over this variable when
# it is set, and takes effect without a restart.
HQ_SCHEDULER=off

# IANA time zone of the routines and of the daily export (for example
# Europe/Paris). Default: the time zone of the machine.
# `timeZone` in <home>/myhq.json wins over this variable when it is set.
HQ_TIMEZONE=

# Your weekly budget in USD, to show the share spent this week on the meter
# and in /status. A calibration value of your own: leave empty to hide it.
HQ_WEEKLY_BUDGET_USD=

# --max-budget-usd of an onboarding run (the agent that proposes a room for a
# repository, on Sonnet). Default: 0.5.
HQ_ONBOARDING_MAX_BUDGET_USD=0.5

# --max-budget-usd for agents whose room.json sets no maxBudgetUsd. Default: 1.
HQ_DEFAULT_MAX_BUDGET_USD=1

# A run still going after this many minutes is killed and marked failed.
# Default: 30.
HQ_RUN_TIMEOUT_MINUTES=30

# The Claude Code binary. Default: claude (found in PATH). Must be an
# executable, not a .cmd shim (native install on Windows).
HQ_CLAUDE_BIN=claude

# Long-lived Claude Code token (`claude setup-token`), to run unattended on a
# subscription without depending on the interactive login. When set, it is
# passed as CLAUDE_CODE_OAUTH_TOKEN to every `claude -p` process MyHQ starts
# (agent runs and the assistant's chat), and only to them. Never logged.
HQ_CLAUDE_OAUTH_TOKEN=

# The assistant on Telegram. With the token and chat id alone, MyHQ only sends
# alerts (an item waits for approval, a run failed), as plain text. Leave empty
# to disable; nothing is sent and nothing fails. Only this chat id is served:
# messages from any other chat are logged and ignored.
HQ_TELEGRAM_BOT_TOKEN=
HQ_TELEGRAM_CHAT_ID=

# Set to true to let MyHQ read the bot's messages (long polling, no inbound
# port): commands, approval buttons on alerts, conversation, voice notes and
# files. Default: off. A bot can only have one reader: keep it off while
# another program still reads this bot, or both will miss messages.
HQ_TELEGRAM_POLLING=false

# Address at which you reach the desk from another device, for example the
# Tailscale name of this machine (see the README, « Accès depuis le téléphone
# et le Mac »). Optional. When set, every alert about an approval ends with
# « Ouvrir : <url>/#approval-<id> », a failed run with « Ouvrir : <url>/#run-<id> »
# and a brief or a summary with « Bureau : <url> ». Without it, alerts are
# unchanged. MyHQ itself keeps listening on 127.0.0.1 only.
HQ_PUBLIC_URL=

# --max-budget-usd of each conversation turn of the assistant (claude -p).
# Default: 0.5.
HQ_CHAT_MAX_BUDGET_USD=0.5

# Local trigger token. When set, a POST /api/runs that carries a "reason"
# (a script of the home, a mail listener...) must send
# "Authorization: Bearer <token>", or it gets 401. The desk sends no reason
# and is not affected. Leave empty to accept every request as before. Use a
# random string of at least 32 characters.
HQ_TRIGGER_TOKEN=

# Cap on one file an agent joins to an item (hq_submit attachments), in MB.
# Default: 200.
HQ_ATTACHMENT_MAX_MB=

# Optional ffmpeg binary (path or command name). When set, the Telegram alert
# of an item whose video is too heavy for a bot (above 50 MB) carries a
# thumbnail of it instead. Unset by default: nothing else needs ffmpeg.
HQ_FFMPEG_BIN=

# Set by MyHQ for each run, never in this file: HQ_DB_PATH, HQ_RUN_ID,
# HQ_AGENT_ID, HQ_ROOM, HQ_WORK_DIR (read by the HQ MCP server).
